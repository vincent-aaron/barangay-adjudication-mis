# Environment files
*.env
*.env.*
**/*.env
config.env
ocr.env

# ignore vendor directory and other dependencies
vendor/
phpmailer/
PhpSpreadsheet/

# ignore all files in the uploads directory
uploads/*
!uploads/.htaccess
uploads_id/*
!uploads_id/.htaccess
SecMenu/uploads/*
!SecMenu/uploads/.htaccess

# SQL dumps
sql/*.sql

# Composer phar
composer.phar
# Node dependencies (Tailwind is loaded from the CDN, not from here)
node_modules/

# IDE / OS files and logs
.vscode/
.idea/
.DS_Store
Thumbs.db
*.log

# Chatbot response log (runtime data, may contain user conversations)
chatbot/log.txt

# Local configuration with real credentials (see config/config.example.php)
config/config.local.php

# Runtime logs
storage/logs/*
!storage/logs/.gitkeep

# Never commit database dumps other than the fictional demo seed
*.sql
!database/demo_seed.sql
